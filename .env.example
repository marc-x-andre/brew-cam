# Copy to .env (never commit .env). Values here are variable NAMES referenced
# from config YAML, not the secrets themselves.
CAMERA_SOURCE=rtsp://wb:REPLACE_WITH_YOUR_WYZE_API_KEY@wyze-bridge:8554/REPLACE_WITH_CAMERA_PATH_FROM_BRIDGE_UI
# YouTube Studio > Go live > "Stream URL" (use the RTMPS variant: click the lock icon to reveal it;
# plain RTMP is shown by default).
YOUTUBE_INGEST_URL=
YOUTUBE_STREAM_KEY=
WYZE_KEY_ID=
WYZE_API_KEY=
# Optional: path (inside the brewcam container) to the session YAML to run.
# Defaults to the example config if left unset.
BREWCAM_CONFIG=
